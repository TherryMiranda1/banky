# Server Port (default: 3001)
PORT=3001

# Node environment (development | production | test)
NODE_ENV=development

# Application ID from Enable Banking Control Panel (must be a valid UUID)
# Example: 11111111-2222-3333-4444-555555555555
APP_ID=

# RSA 4096-bit Private Key for signing JWTs to Enable Banking API
# Generate key with: openssl genrsa 4096
# Format as single-line string with literal \n escapes or valid PEM string
PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# AES-256-GCM 32-byte hex key (64 characters) for encrypting bank session IDs in SQLite DB
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Redirect URL configured in Enable Banking application settings
ENABLE_BANKING_REDIRECT_URL=http://localhost:5173/auth/callback

# Frontend application base URL for CORS and OAuth return redirects
FRONTEND_URL=http://localhost:5173

# Optional: Enable Banking Base API URL (default: https://api.enablebanking.com)
# ENABLE_BANKING_BASE_URL=https://api.enablebanking.com

# Optional: Custom SQLite database path (default: ./banky.db)
# DB_PATH=./banky.db
